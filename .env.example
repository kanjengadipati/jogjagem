# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PORT: The port for the Next.js dev server.
PORT=3001

# NEXT_PUBLIC_ADMIN_URL: URL of the admin portal. Used for the Admin Panel button in the header.
# Change to your deployed admin URL on production (e.g. https://admin.jogjagem.com).
NEXT_PUBLIC_ADMIN_URL=http://localhost:3002

# NEXT_PUBLIC_API_BASE: Base URL of the backend API (used client-side).
NEXT_PUBLIC_API_BASE=http://localhost:8081

# API_BASE: Server-side only API base URL (used in Server Components / generateMetadata).
# Set this to the internal service URL in production for reliability.
API_BASE=http://localhost:8081

# NEXT_PUBLIC_BUSINESS_PLATFORM: Which business platform to serve under /business/*.
# "new" = cloned business portal (from jogjagem-admin) inside this app.
# unset / anything else = the legacy landing + claim + invite pages.
#NEXT_PUBLIC_BUSINESS_PLATFORM=new

# Cloudinary upload signing (used by business-portal CoverImageUpload via /api/upload)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Midtrans Snap (business-portal subscription & ad-campaign checkout)
NEXT_PUBLIC_MIDTRANS_IS_PRODUCTION=false
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=

# Umami Analytics
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_SCRIPT_URL=
